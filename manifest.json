{
    "manifest_version" : 3,
    "name" :            "Rabbit Hole",
    "version" :         "0.1.0",
    "description" :     "Organize browser research into interconnected tunnels & burrow map",
    "permissions" : [
        "tabs", 
        "sidePanel",
        "storage"

    ],
    "background":{
        "service_worker":   "background.js"
    },
    "side_panel":{
        "default_path":     "sidepanel.html"
    },
    "action":{
        "default_title":    "Open Rabbit Hole"
    }

}